{
  "name": "telly",
  "version": "0.0.0",
  "private": true,
  "description": "An Effect-native Telegram Bot API framework designed for agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun build ./index.ts --outdir ./dist --target node --format esm --packages external && tsc --project ./tsconfig.build.json",
    "check": "bun run typecheck && bun run test && bun run schema:check && bun run test:node",
    "schema:check": "bun run ./schema/check.ts",
    "test": "bun test --pass-with-no-tests",
    "test:node": "bun run build && node --input-type=module --eval \"await import('./dist/index.js')\"",
    "typecheck": "tsc --project ./tsconfig.json && tsc --project ./tsconfig.test.json"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
