{
  "name": "telly",
  "version": "0.0.0",
  "private": true,
  "description": "An Effect-native Telegram Bot API framework designed for agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "bench": "bun run build && bun benchmarks/orchestrator/run.ts --preset quick",
    "bench:baseline": "bun run build && bun benchmarks/orchestrator/run.ts --preset full --baseline",
    "bench:full": "bun run build && bun benchmarks/orchestrator/run.ts --preset full",
    "bench:setup": "bun install --frozen-lockfile && bun install --cwd benchmarks/runners/grammy --frozen-lockfile && bun install --cwd benchmarks/runners/puregram --frozen-lockfile && uv sync --project benchmarks/runners/ptb --frozen",
    "build": "bun run ./scripts/build.ts && tsc --project ./tsconfig.build.json",
    "check": "bun run typecheck && bun run test && bun run schema:check && bun run test:node",
    "e2e:read-only-methods": "bun run ./scripts/e2e/read-only-methods.mjs",
    "e2e:bot-profile-settings": "bun run ./scripts/e2e/bot-profile-settings.mjs",
    "e2e:beginner-bot": "bun run ./scripts/e2e/beginner-bot.mjs",
    "e2e:botfather-fixtures": "bun run ./scripts/e2e/botfather-fixtures.mjs",
    "e2e:custom-emoji": "bun run ./scripts/e2e/custom-emoji.mjs",
    "e2e:conversations": "bun run ./scripts/e2e/conversations.mjs",
    "e2e:disposable-bots": "bun run ./scripts/e2e/disposable-bots.mjs",
    "e2e:entitlements": "bun run ./scripts/e2e/entitlements.mjs",
    "e2e:message-lifecycle": "bun run ./scripts/e2e/message-lifecycle.mjs",
    "e2e:isolated-group": "bun run ./scripts/e2e/isolated-group.mjs",
    "e2e:jobs": "bun run ./scripts/e2e/jobs.mjs",
    "e2e:profile-photo": "bun run ./scripts/e2e/profile-photo.mjs",
    "e2e:personal-channel": "bun run ./scripts/e2e/personal-channel.mjs",
    "e2e:payments": "bun run ./scripts/e2e/payments.mjs",
    "e2e:send-message": "bun run ./scripts/e2e/send-message.mjs",
    "e2e:send-photo": "TELLY_E2E_SEND_METHOD=sendPhoto bun run ./scripts/e2e/send-message.mjs",
    "e2e:superseriousbot-sed": "bun run ./scripts/e2e/superseriousbot-sed.mjs",
    "e2e:sticker-set": "bun run ./scripts/e2e/sticker-set.mjs",
    "e2e:webhook": "bun run ./scripts/e2e/webhook.mjs",
    "schema:check": "bun run ./bot-api/schema/check.ts",
    "schema:generate": "bun run ./bot-api/schema/generate.ts",
    "test": "bun test --pass-with-no-tests",
    "test:node": "bun run build && node ./test/node-smoke.mjs",
    "typecheck": "tsc --project ./tsconfig.json && tsc --project ./tsconfig.test.json && tsc --project ./benchmarks/tsconfig.json"
  },
  "dependencies": {
    "@libsql/client": "0.17.4",
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
