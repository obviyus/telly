{
  "name": "telly",
  "version": "0.0.0",
  "private": true,
  "description": "An Effect-native Telegram Bot API framework designed for agents.",
  "license": "MIT",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "bun run ./scripts/build.ts && tsc --project ./tsconfig.build.json",
    "check": "bun run typecheck && bun run test && bun run schema:check && bun run test:node",
    "e2e:send-message": "bun run ./scripts/e2e/send-message.mjs",
    "schema:check": "bun run ./schema/check.ts",
    "schema:generate": "bun run ./schema/generate.ts",
    "test": "bun test --pass-with-no-tests",
    "test:node": "bun run build && node ./test/node-smoke.mjs",
    "typecheck": "tsc --project ./tsconfig.json && tsc --project ./tsconfig.test.json"
  },
  "dependencies": {
    "effect": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "@types/node": "^22.0.0",
    "typescript": "7.0.2"
  }
}
